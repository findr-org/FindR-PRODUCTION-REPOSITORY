# Copy to .env and update the database credentials and secret key.
APP_NAME=findR
ENV=dev
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL (asyncpg driver).
PRIMARY_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/findr
# Optional read replica; leave empty to use the primary database.
READ_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# Redis is required only when caching is enabled.
REDIS_URL=
CACHE_ENABLED=false

# Replace with a randomly generated secret of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=5
DEFAULT_SESSION_DAYS=7
REMEMBER_ME_SESSION_DAYS=30

# JSON array of frontend origins allowed to access the API.
ALLOWED_ORIGINS=["http://localhost:5173"]
